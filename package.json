{
  "name": "teemo-assistant",
  "version": "1.3.2",
  "description": "哈啰桌面AI机器人 - 设计助手",
  "main": "main.js",
  "author": "Teemo Wang",
  "scripts": {
    "start": "electron .",
    "verify:release-version": "node scripts/TeemoVerifyReleaseVersion.js",
    "project:knowledge:sync": "node scripts/TeemoProjectKnowledge.js sync",
    "project:knowledge:verify": "node scripts/TeemoProjectKnowledge.js verify",
    "test:auto-update": "node tests/TeemoAutoUpdatePolicy.test.js",
    "test:inspiration-foundation": "node tests/TeemoInspirationFoundation.test.js",
    "test:inspiration-isolation": "node tests/TeemoInspirationIsolation.test.js",
    "test:inspiration-ui-smoke": "electron tests/TeemoInspirationFoundationElectronSmoke.js",
    "test:local-folder": "node tests/TeemoLocalFolderConnector.test.js",
    "test:local-folder-isolation": "node tests/TeemoLocalFolderIsolation.test.js",
    "test:local-folder-ui-smoke": "electron tests/TeemoLocalFolderConnectorElectronSmoke.js",
    "test:inspiration-index": "node tests/TeemoInspirationMetadataIndex.test.js",
    "test:inspiration-index-isolation": "node tests/TeemoInspirationMetadataIndexIsolation.test.js",
    "test:inspiration-index-ui-smoke": "electron tests/TeemoInspirationMetadataIndexElectronSmoke.js",
    "test:inspiration-retrieval": "node tests/TeemoInspirationRetrieval.test.js",
    "test:inspiration-retrieval-ui-smoke": "electron tests/TeemoInspirationRetrievalElectronSmoke.js",
    "test:inspiration-context": "node tests/TeemoInspirationContextBuilder.test.js",
    "test:inspiration-context-ui-smoke": "electron tests/TeemoInspirationContextElectronSmoke.js",
    "test:eagle-library": "node tests/TeemoEagleLibraryConnector.test.js",
    "test:eagle-library-ui-smoke": "electron tests/TeemoEagleLibraryElectronSmoke.js",
    "test:agent-core": "node tests/TeemoAgentCore.test.js",
    "test:chat-tool-calling-ui-smoke": "electron tests/TeemoChatToolCallingElectronSmoke.js",
    "test:screen-awareness": "node tests/TeemoScreenService.test.js",
    "test:screen-awareness-ui-smoke": "electron tests/TeemoScreenElectronSmoke/TeemoScreenElectronSmoke.js",
    "test:cognition": "node tests/TeemoCognition.test.js",
    "test:cognition-management": "node tests/TeemoCognitionManagement.test.js",
    "test:cognition-ui-smoke": "electron tests/TeemoCognitionCenterElectronSmoke.js",
    "test:cognition-intelligence": "node tests/TeemoCognitionIntelligence.test.js",
    "test:cognition-ranking": "node tests/TeemoCognitionRanking.test.js",
    "test:cognition-intelligence-integration": "node tests/TeemoCognitionIntelligenceIntegration.test.js",
    "test:cognition-intelligence-ui-smoke": "electron tests/TeemoCognitionIntelligenceElectronSmoke.js",
    "test:creative-profile": "node tests/TeemoCreativeProfile.test.js",
    "test:creative-context": "node tests/TeemoCreativeContext.test.js",
    "test:creative-ui-smoke": "electron tests/TeemoCreativeProfileElectronSmoke.js",
    "test:creative-director": "node tests/TeemoCreativeDirector.test.js",
    "test:challenge-context": "node tests/TeemoChallengeContext.test.js",
    "test:creative-director-ui-smoke": "electron tests/TeemoCreativeDirectorElectronSmoke.js",
    "test:skill-manifest": "node tests/TeemoSkillManifest.test.js",
    "test:skill-legacy-import": "node tests/TeemoSkillLegacyImport.test.js",
    "test:skill-router": "node tests/TeemoSkillRouter.test.js",
    "test:skill-composition": "node tests/TeemoSkillComposition.test.js",
    "test:skill-session": "node tests/TeemoSkillSession.test.js",
    "test:skill-integration": "node tests/TeemoSkillIntegration.test.js",
    "test:skill-benchmark": "node tests/TeemoSkillRoutingBenchmark.test.js",
    "test:skill-ui-smoke": "electron tests/TeemoSkillIntelligenceElectronSmoke.js",
    "test:tools": "node tests/TeemoToolRegistry.test.js",
    "test:permissions": "node tests/TeemoPermissionService.test.js",
    "test:file-tools": "node tests/TeemoFileTools.test.js",
    "test:git-tools": "node tests/TeemoGitTools.test.js",
    "test:execute": "node tests/TeemoExecuteTools.test.js",
    "predist": "npm run verify:release-version",
    "dist": "electron-builder --publish never",
    "predist:mac": "npm run verify:release-version",
    "dist:mac": "electron-builder --mac --publish never",
    "predist:win": "npm run verify:release-version",
    "dist:win": "electron-builder --win --publish never",
    "prerelease": "npm run verify:release-version",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "cn.teemo.assistant",
    "productName": "Teemo助理",
    "artifactName": "Teemo-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "dingtalk-bridge.js",
      "material-bridge.js",
      "index.html",
      "config.json",
      "yuque-teams.local.json",
      "pet.png",
      "styles.css",
      "src/**/*",
      "js/**/*",
      "styles/**/*",
      "Teemo-chat-window/**/*",
      "skills/**/*",
      "Teemo-mouse-press.ps1",
      "icon/**/*",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Teemo-Wang",
        "repo": "desktop-pet"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon/app.icns",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "win": {
      "icon": "icon/Teemo-app.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "electron-updater": "^6.3.9",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.21.0"
  }
}
