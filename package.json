{
  "name": "teemo-assistant",
  "version": "1.2.1",
  "description": "哈啰桌面AI机器人 - 设计助手",
  "main": "main.js",
  "author": "Teemo Wang",
  "scripts": {
    "start": "electron .",
    "verify:release-version": "node scripts/TeemoVerifyReleaseVersion.js",
    "test:agent-core": "node tests/TeemoAgentCore.test.js",
    "test:cognition": "node tests/TeemoCognition.test.js",
    "test:cognition-management": "node tests/TeemoCognitionManagement.test.js",
    "test:cognition-ui-smoke": "electron tests/TeemoCognitionCenterElectronSmoke.js",
    "test:tools": "node tests/TeemoToolRegistry.test.js",
    "test:permissions": "node tests/TeemoPermissionService.test.js",
    "test:file-tools": "node tests/TeemoFileTools.test.js",
    "test:git-tools": "node tests/TeemoGitTools.test.js",
    "test:execute": "node tests/TeemoExecuteTools.test.js",
    "predist": "npm run verify:release-version",
    "dist": "electron-builder --publish never",
    "predist:mac": "npm run verify:release-version",
    "dist:mac": "electron-builder --mac --publish never",
    "predist:win": "npm run verify:release-version",
    "dist:win": "electron-builder --win --publish never",
    "prerelease": "npm run verify:release-version",
    "release": "electron-builder --publish always"
  },
  "build": {
    "appId": "cn.teemo.assistant",
    "productName": "Teemo助理",
    "artifactName": "Teemo-${version}-${arch}.${ext}",
    "files": [
      "main.js",
      "dingtalk-bridge.js",
      "material-bridge.js",
      "index.html",
      "config.json",
      "yuque-teams.local.json",
      "pet.png",
      "styles.css",
      "src/**/*",
      "js/**/*",
      "styles/**/*",
      "Teemo-chat-window/**/*",
      "skills/**/*",
      "Teemo-mouse-press.ps1",
      "icon/**/*",
      "!**/*.map",
      "!**/.DS_Store"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "Teemo-Wang",
        "repo": "desktop-pet"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "icon/app.icns",
      "target": [
        { "target": "dmg", "arch": ["universal"] },
        { "target": "zip", "arch": ["universal"] }
      ]
    },
    "dmg": {
      "title": "${productName} ${version}"
    },
    "win": {
      "icon": "icon/Teemo-app.png",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "electron-updater": "^6.3.9",
    "mammoth": "^1.8.0",
    "pdf-parse": "^1.1.1",
    "ws": "^8.21.0"
  }
}
